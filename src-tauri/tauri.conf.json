{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneMail Wanglai",
  "version": "26.1119.2306",
  "identifier": "com.huzhihui.onemail.wanglai",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:27502",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "libgtk-3-0t64 | libgtk-3-0"
        ]
      }
    }
  },
  "mainBinaryName": "one-mail-wanglai"
}
